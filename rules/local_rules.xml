<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>
<group name="local,windows,persistence,">
  <rule id="100100" level="12">
    <if_sid>60228</if_sid>
    <field name="win.eventdata.taskContent" type="pcre2">(?i)WindowStyle\s+Hidden</field>
    <description>Scheduled task created that runs a hidden PowerShell window - possible persistence</description>
    <mitre>
      <id>T1053.005</id>
      <id>T1564.003</id>
    </mitre>
  </rule>
</group>
<group name="local,ids,suricata,scan,">
  <rule id="100101" level="3">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">^ET SCAN</field>
    <description>Suricata ET SCAN alert: $(alert.signature)</description>
  </rule>

  <rule id="100102" level="10" frequency="4" timeframe="60">
    <if_matched_sid>100101</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Multiple Suricata scan alerts from the same source IP - possible port scan</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>
</group>
<group name="local,windows,sysmon,">
  <rule id="100103" level="0">
    <if_sid>92205</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\__PSScriptPolicyTest_[a-z0-9.]+\.ps(m)?1$</field>
    <description>PowerShell execution policy test file - known false positive (INC-006)</description>
  </rule>
</group>
